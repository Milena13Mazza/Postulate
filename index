});

function showError(msg){
  const el = document.getElementById('error-msg');
  el.textContent = msg;
  el.style.display = msg ? 'block' : 'none';
}

function downloadBlob(content, filename, mime){
  const blob = new Blob([content], {type:mime});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function generate(){
  if(!PROFILE){ showError('Primero cargá y guardá tu perfil.'); return; }
  const posting = document.getElementById('posting').value.trim();
  if(!posting){ showError('Pegá el texto del aviso antes de generar.'); return; }
  const urlOnlyPattern = /^https?:\/\/\S+$/i;
  const wordCount = posting.split(/\s+/).filter(Boolean).length;
  if(urlOnlyPattern.test(posting) || (posting.includes('http') && wordCount < 6)){
    showError('Eso parece ser solo un link. La app no puede leer páginas — entrá al aviso, copiá el texto completo (título, descripción, requisitos) y pegalo acá.');
    return;
  }
  showError('');

  const company = document.getElementById('company').value.trim();
  const amount = document.getElementById('amount').value.trim();
  const currency = document.getElementById('currency').value;

  const btn = document.getElementById('generate-btn');
  const btnLabel = document.getElementById('btn-label');
  btn.disabled = true;
  btnLabel.innerHTML = '<span class="spinner"></span>';

  try{
    window._lastPosting = posting;
    const parsed = computeResult(posting, { company }, outputLang, PROFILE);
    lastResult = parsed;
    const meta = { company, amount, currency, availability: selectedAvail, includeRate: includeRate && !!amount, lang: outputLang };
    window._lastMeta = meta;

    const warningEl = document.getElementById('mismatch-warning');
    const warningMsgs = [];
    if(parsed.relevance.isOffTopic){
      warningMsgs.push(outputLang === 'en'
        ? "⚠ This posting doesn't seem to overlap much with your profile — double check it before sending."
        : '⚠ Este aviso no parece coincidir mucho con tu perfil — revisalo bien antes de mandarlo.');
    }
    if(parsed.asksSalary && !amount){
      warningMsgs.push(outputLang === 'en'
        ? '💰 This posting explicitly asks for your salary expectations, but you haven\'t filled in the "expected rate" field.'
        : '💰 Este aviso pide explícitamente tu pretensión salarial, pero no cargaste el campo "Tarifa pretendida".');
    }
    warningEl.style.display = warningMsgs.length ? 'block' : 'none';
    warningEl.textContent = warningMsgs.join(' ');

    renderResult(parsed, meta, PROFILE);

    const rateSummaryEl = document.getElementById('rate-summary');
    if(meta.includeRate){
      const period = currency.split('/')[1];
      const code = currency.split('/')[0];
      rateSummaryEl.textContent = (outputLang === 'en' ? 'Rate mentioned in email: ' : 'Tarifa mencionada en el email: ') + `${amount} ${code}/${PERIOD_LABEL[outputLang][period]} · ` + (outputLang === 'en' ? 'availability: ' : 'disponibilidad: ') + AVAIL_MAP[selectedAvail][outputLang];
    } else {
      rateSummaryEl.textContent = outputLang === 'en' ? 'Rate not included in email (toggle is off or no amount set).' : 'La tarifa no se incluye en el email (el switch está apagado o no cargaste un monto).';
    }
  }catch(err){
    console.error('Error al generar:', err);
    showError('No se pudo generar: ' + err.message);
  }finally{
    btn.disabled = false;
    btnLabel.textContent = 'Generar postulación';
  }
}

document.getElementById('generate-btn').addEventListener('click', generate);

document.getElementById('dl-cv').addEventListener('click', ()=>{
  if(!lastResult) return;
  const filename = `CV_${(PROFILE.name||'postulacion').replace(/[^a-zA-Z0-9]+/g,'_')}.pdf`;
  const doc = buildCvPdf(lastResult, PROFILE);
  doc.save(filename);
});

document.getElementById('dl-cv-txt').addEventListener('click', ()=>{
  if(!lastResult) return;
  const filename = `CV_${(PROFILE.name||'postulacion').replace(/[^a-zA-Z0-9]+/g,'_')}.txt`;
  downloadBlob(buildCvText(lastResult, PROFILE), filename, 'text/plain');
});

document.getElementById('dl-cover').addEventListener('click', ()=>{
  if(!lastResult || !window._lastMeta) return;
  const filename = `Carta_${(PROFILE.name||'postulacion').replace(/[^a-zA-Z0-9]+/g,'_')}.pdf`;
  const doc = buildCoverLetterPdf(lastResult, window._lastMeta, PROFILE);
  doc.save(filename);
});

document.getElementById('dl-cover-txt').addEventListener('click', ()=>{
  if(!lastResult || !window._lastMeta) return;
  const filename = `Carta_${(PROFILE.name||'postulacion').replace(/[^a-zA-Z0-9]+/g,'_')}.txt`;
  downloadBlob(buildCoverLetterText(lastResult, window._lastMeta, PROFILE), filename, 'text/plain');
});

document.getElementById('copy-email-text').addEventListener('click', async ()=>{
  if(!lastResult || !window._lastMeta) return;
  const text = buildEmailPlainText(lastResult, window._lastMeta);
  const full = `${lastResult.email.subject}\n\n${text}`;
  try{
    await navigator.clipboard.writeText(full);
    const btn = document.getElementById('copy-email-text');
    const original = btn.textContent;
    btn.textContent = '¡Copiado!';
    setTimeout(()=>{ btn.textContent = original; }, 1500);
  }catch(e){
    showError('No se pudo copiar automáticamente. Seleccioná el texto manualmente.');
  }
});

document.getElementById('dl-email').addEventListener('click', ()=>{
  if(!window._lastEmailHtml) return;
  downloadBlob(window._lastEmailHtml, `Email_${(PROFILE && PROFILE.name ? PROFILE.name.replace(/[^a-zA-Z0-9]+/g,'_') : 'postulacion')}.html`, 'text/html');
});

</script>
</body>
