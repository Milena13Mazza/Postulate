function buildCoverLetterPdf(r, meta, profile){
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'pt', format: 'a4' });
  const marginX = 56;
  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const usableWidth = pageWidth - marginX * 2;
  const bottomMargin = 56;
  let y = 64;

  function sanitize(s){ return (s || '').replace(/[→➔➡⇒]/g, '/').replace(/\u00A0/g, ' '); }
  function checkBreak(neededHeight){ if(y + neededHeight > pageHeight - bottomMargin){ doc.addPage(); y = 64; } }
  function para(text, opts = {}){
    const { size = 11, style = 'normal', gap = 15.5, spaceAfter = 14 } = opts;
    doc.setFont('helvetica', style);
    doc.setFontSize(size);
    doc.setTextColor(40,40,40);
    const lines = doc.splitTextToSize(sanitize(text), usableWidth);
    checkBreak(lines.length * gap);
    lines.forEach(line => { doc.text(line, marginX, y); y += gap; });
    y += spaceAfter;
  }

  doc.setFont('helvetica', 'bold');
  doc.setFontSize(15);
  doc.setTextColor(15,15,15);
  doc.text(sanitize(profile.name), marginX, y);
  y += 16;
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(9.5);
  doc.setTextColor(100,100,100);
  const contactLine = [profile.email, profile.phone, profile.location].filter(Boolean).join('  ·  ');
  doc.text(sanitize(contactLine), marginX, y);
  y += 12;

  doc.setTextColor(60,55,140);
  let clx = marginX;
  const linkParts = [
    profile.portfolioUrl ? { label: profile.portfolioUrl.replace(/^https?:\/\//,''), url: profile.portfolioUrl } : null,
    profile.linkedinUrl ? { label: profile.linkedinUrl.replace(/^https?:\/\//,''), url: profile.linkedinUrl } : null,
    profile.whatsappUrl ? { label: 'WhatsApp', url: profile.whatsappUrl } : null
  ].filter(Boolean);
  linkParts.forEach((part,i)=>{
    doc.textWithLink(part.label, clx, y, { url: part.url });
    clx += doc.getTextWidth(part.label) + 6;
    if(i < linkParts.length - 1){ doc.setTextColor(100,100,100); doc.text('·', clx, y); clx += doc.getTextWidth('·') + 6; doc.setTextColor(60,55,140); }
  });
  doc.setTextColor(100,100,100);
  y += 24;

  para(letterDateLine(r, profile), { size: 10, spaceAfter: 18 });
  para(letterGreeting(r, meta, profile), { style: 'bold', size: 11, spaceAfter: 12 });
  buildCoverLetterParagraphs(r, meta).forEach(p => para(p));
  y += 6;
  para(letterSignOff(r), { spaceAfter: 2 });
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(11);
  doc.setTextColor(20,20,20);
  doc.text(sanitize(profile.name), marginX, y);

  return doc;
}

function buildCvPdf(r, profile){
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ unit: 'pt', format: 'a4' });
  const marginX = 48;
  const pageWidth = doc.internal.pageSize.getWidth();
  const pageHeight = doc.internal.pageSize.getHeight();
  const usableWidth = pageWidth - marginX * 2;
  const bottomMargin = 50;
  let y = 56;

  function sanitize(s){ return (s || '').replace(/[→➔➡⇒]/g, '/').replace(/\u00A0/g, ' '); }
  function checkBreak(neededHeight){ if(y + neededHeight > pageHeight - bottomMargin){ doc.addPage(); y = 56; } }
  function addWrapped(text, opts = {}){
    const { size = 10, style = 'normal', color = [40,40,40], gap = 13.5, indent = 0 } = opts;
    doc.setFont('helvetica', style);
    doc.setFontSize(size);
    doc.setTextColor(color[0], color[1], color[2]);
    const lines = doc.splitTextToSize(sanitize(text), usableWidth - indent);
    checkBreak(lines.length * gap);
    lines.forEach(line => { doc.text(line, marginX + indent, y); y += gap; });
  }
  function addBullet(text){
    const size = 10, gap = 13.5, bulletIndent = 12;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(size);
    doc.setTextColor(40,40,40);
    const lines = doc.splitTextToSize(sanitize(text), usableWidth - bulletIndent);
    checkBreak(lines.length * gap);
    lines.forEach((line, i) => {
      if(i === 0) doc.text('•', marginX, y);
      doc.text(line, marginX + bulletIndent, y);
      y += gap;
    });
  }
  function sectionHeader(label){
    y += 6;
    checkBreak(24);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(10.5);
    doc.setTextColor(20,20,20);
    doc.text(label.toUpperCase(), marginX, y);
    y += 4;
    doc.setDrawColor(200,200,200);
    doc.line(marginX, y, marginX + usableWidth, y);
    y += 16;
  }

  const L = LABELS[r.lang];

  doc.setFont('helvetica', 'bold');
  doc.setFontSize(20);
  doc.setTextColor(15,15,15);
  doc.text(sanitize(profile.name), marginX, y);
  y += 22;

  doc.setFont('helvetica', 'bold');
  doc.setFontSize(12);
  doc.setTextColor(60,55,140);
  doc.text(sanitize(r.title), marginX, y);
  y += 16;

  doc.setFont('helvetica', 'normal');
  doc.setFontSize(9.5);
  doc.setTextColor(90,90,90);
  const contactLine = [profile.email, profile.phone, profile.location].filter(Boolean).join('   ·   ');
  if(contactLine){ doc.text(sanitize(contactLine), marginX, y); y += 12; }

  doc.setTextColor(60,55,140);
  let linkX = marginX;
  const linkParts = [
    profile.portfolioUrl ? { label: profile.portfolioUrl.replace(/^https?:\/\//,''), url: profile.portfolioUrl } : null,
    profile.linkedinUrl ? { label: profile.linkedinUrl.replace(/^https?:\/\//,''), url: profile.linkedinUrl } : null,
    profile.whatsappUrl ? { label: 'WhatsApp', url: profile.whatsappUrl } : null
  ].filter(Boolean);
  if(linkParts.length){
    linkParts.forEach((part, i) => {
      doc.textWithLink(part.label, linkX, y, { url: part.url });
      linkX += doc.getTextWidth(part.label) + 6;
      if(i < linkParts.length - 1){
        doc.setTextColor(90,90,90);
        doc.text('·', linkX, y);
        linkX += doc.getTextWidth('·') + 6;
        doc.setTextColor(60,55,140);
      }
    });
    doc.setTextColor(90,90,90);
    y += 18;
  } else {
    y += 6;
  }

  sectionHeader(L.profile);
  addWrapped(r.summary);

  sectionHeader(L.experience);
  (r.experience||[]).forEach(job => {
    checkBreak(24);
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(11);
    doc.setTextColor(20,20,20);
    doc.text(sanitize(`${job.role} — ${job.company}`), marginX, y);
    y += 13;
    doc.setFont('helvetica', 'italic');
    doc.setFontSize(9);
    doc.setTextColor(120,120,120);
    const metaLine = [job.location, job.dates].filter(Boolean).join('  ·  ');
    if(metaLine){ doc.text(sanitize(metaLine), marginX, y); y += 13; }
    (job.bullets||[]).forEach(b => addBullet(b));
    y += 6;
  });

  sectionHeader(L.education);
  (profile.education||[]).forEach(line => addWrapped(line));

  sectionHeader(L.skills);
  addWrapped((r.skills || []).join('  ·  '));

  sectionHeader(L.languages);
  addWrapped(profile.languages || '');

  if(r.asksSalary && window._lastMeta && window._lastMeta.amount){
    const meta = window._lastMeta;
    const period = meta.currency.split('/')[1];
    const code = meta.currency.split('/')[0];
    const currencyDisplay = `${code}/${PERIOD_LABEL[r.lang][period]}`;
    const availDisplay = AVAIL_MAP[meta.availability] ? AVAIL_MAP[meta.availability][r.lang] : meta.availability;
    sectionHeader(r.lang === 'en' ? 'Salary Expectations' : 'Pretensión salarial');
    addWrapped(`${meta.amount} ${currencyDisplay} — ${r.lang==='en' ? 'availability: ' : 'disponibilidad: '}${availDisplay}`);
  }

  return doc;
}

function buildCvText(r, profile){
  const L = LABELS[r.lang];
  const lines = [];
  lines.push(profile.name);
  lines.push(r.title);
  lines.push([profile.email, profile.phone, profile.location].filter(Boolean).join(' | '));
  lines.push([profile.portfolioUrl, profile.linkedinUrl, profile.whatsappUrl ? `WhatsApp: ${profile.whatsappDisplay||profile.whatsappUrl}` : ''].filter(Boolean).join(' | '));
  lines.push('');
  lines.push(L.profile.toUpperCase());
  lines.push(r.summary);
  lines.push('');
  lines.push(L.experience.toUpperCase());
  (r.experience||[]).forEach(job => {
    lines.push(`${job.role} — ${job.company}`);
    const metaLine = [job.location, job.dates].filter(Boolean).join(' · ');
    if(metaLine) lines.push(metaLine);
    (job.bullets||[]).forEach(b => lines.push(`- ${b}`));
    lines.push('');
  });
  lines.push(L.education.toUpperCase());
  (profile.education||[]).forEach(l => lines.push(l));
  lines.push('');
  lines.push(L.skills.toUpperCase());
  lines.push((r.skills || []).join(', '));
  lines.push('');
  lines.push(L.languages.toUpperCase());
  lines.push(profile.languages || '');
  if(r.asksSalary && window._lastMeta && window._lastMeta.amount){
    const meta = window._lastMeta;
    const period = meta.currency.split('/')[1];
    const code = meta.currency.split('/')[0];
    const currencyDisplay = `${code}/${PERIOD_LABEL[r.lang][period]}`;
    const availDisplay = AVAIL_MAP[meta.availability] ? AVAIL_MAP[meta.availability][r.lang] : meta.availability;
    lines.push('');
    lines.push((r.lang === 'en' ? 'SALARY EXPECTATIONS' : 'PRETENSIÓN SALARIAL'));
    lines.push(`${meta.amount} ${currencyDisplay} — ${r.lang==='en' ? 'availability: ' : 'disponibilidad: '}${availDisplay}`);
  }
  return lines.join('\n');
}
/* ===================== Parseo de PDF y formulario de perfil ===================== */
if(window.pdfjsLib){
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
}

function escAttr(s){
  return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

async function extractPdfText(file){
  const buf = await file.arrayBuffer();
  const pdf = await pdfjsLib.getDocument({ data: buf }).promise;
  let text = '';
  for(let i=1;i<=pdf.numPages;i++){
    const page = await pdf.getPage(i);
    const content = await page.getTextContent();
    let lastY = null;
    content.items.forEach(item => {
      const y = item.transform[5];
      if(lastY !== null && Math.abs(y - lastY) > 2){ text += '\n'; }
      else if(lastY !== null){ text += ' '; }
      text += item.str;
      lastY = y;
    });
    text += '\n\n';
  }
  return text;
}

const SECTION_HEADERS = {
  experience: /^(experiencia( laboral)?|experience|trayectoria|historial laboral|work experience)\s*:?$/i,
  education: /^(educaci[oó]n|formaci[oó]n( acad[eé]mica)?|education)\s*:?$/i,
  skills: /^(habilidades|herramientas|skills|tecnolog[ií]as|competencias|tools)\s*:?$/i,
  languages: /^(idiomas|languages)\s*:?$/i,
  summary: /^(perfil( profesional)?|resumen( profesional)?|about|summary|profile|objetivo)\s*:?$/i
};

function parseCvText(raw){
  const lines = raw.split('\n').map(l=>l.trim()).filter(Boolean);
  const draft = { name:'', email:'', phone:'', location:'', linkedinUrl:'', portfolioUrl:'', whatsappDisplay:'', whatsappUrl:'', headline:'', yearsExperience:'', fieldOfWork:'', summary:'', notableClients:'', education:[], languages:'', experience:[], skills:[] };

  const emailMatch = raw.match(/[\w.+-]+@[\w-]+\.[\w.-]+/);
  if(emailMatch) draft.email = emailMatch[0];

  const linkedinMatch = raw.match(/(https?:\/\/)?(www\.)?linkedin\.com\/in\/[a-zA-Z0-9\-_%]+/i);
  if(linkedinMatch) draft.linkedinUrl = linkedinMatch[0].startsWith('http') ? linkedinMatch[0] : 'https://' + linkedinMatch[0].replace(/^\/\//,'');

  const urlMatches = raw.match(/(https?:\/\/[^\s,;]+)|(\bwww\.[^\s,;]+)/g) || [];
  const portfolioCandidate = urlMatches.find(u => !/linkedin|facebook|instagram|twitter|x\.com/i.test(u));
  if(portfolioCandidate) draft.portfolioUrl = portfolioCandidate.startsWith('http') ? portfolioCandidate : 'https://' + portfolioCandidate;

  const phoneMatch = raw.match(/(\+?\d[\d\s\-\(\)]{7,}\d)/);
  if(phoneMatch) draft.phone = phoneMatch[0].trim();

  const nameLine = lines.slice(0,6).find(l => /^[A-ZÁÉÍÓÚÑ][a-zA-ZÁÉÍÓÚÑáéíóúñ'’\-]+(\s+[A-ZÁÉÍÓÚÑ][a-zA-ZÁÉÍÓÚÑáéíóúñ'’\-]+){1,3}$/.test(l) && l.length < 40 && !/@/.test(l));
  if(nameLine) draft.name = nameLine;

  const sectionsIdx = [];
  lines.forEach((l, i) => {
    for(const key of Object.keys(SECTION_HEADERS)){
      if(SECTION_HEADERS[key].test(l)) sectionsIdx.push({ key, i });
    }
  });
  sectionsIdx.sort((a,b)=>a.i-b.i);

  function sliceSection(idx){
    const start = idx.i + 1;
    const next = sectionsIdx.find(s => s.i > idx.i);
    const end = next ? next.i : lines.length;
    return lines.slice(start, end);
  }

  sectionsIdx.forEach(idx => {
    const chunk = sliceSection(idx);
    if(idx.key === 'summary' && !draft.summary) draft.summary = chunk.slice(0,4).join(' ');
    if(idx.key === 'education') draft.education = chunk.filter(l=>l.length>3).slice(0,8);
    if(idx.key === 'languages') draft.languages = chunk.slice(0,3).join(' · ');
    if(idx.key === 'skills'){
      const skillText = chunk.slice(0,6).join(', ');
      draft.skills = skillText.split(/[,·•|]/).map(s=>s.trim()).filter(s=>s.length>1 && s.length<30).slice(0,14).map(name=>({ name, level:'Intermedio' }));
    }
    if(idx.key === 'experience' && chunk.length){
      const roleLine = chunk.find(l => l.length < 80) || '';
      draft.experience.push({
        role: roleLine,
        company: '',
        location: '',
        dates: '',
        bullets: chunk.filter(l => l !== roleLine).slice(0,8)
      });
    }
  });

  return draft;
}

