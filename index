let skillsState = [];

function addJobBlock(job){
  job = job || { role:'', company:'', location:'', dates:'', bullets:[] };
  const container = document.getElementById('jobs-container');
  const div = document.createElement('div');
  div.className = 'job-block';
  div.innerHTML = `
    <span class="rm-job">✕ quitar</span>
    <div class="job-row2">
      <div><label style="margin-top:0;">Puesto</label><input class="j-role" type="text" value="${escAttr(job.role)}"></div>
      <div><label style="margin-top:0;">Empresa</label><input class="j-company" type="text" value="${escAttr(job.company)}"></div>
    </div>
    <div class="job-row2" style="margin-top:10px;">
      <div><label style="margin-top:0;">Ubicación</label><input class="j-location" type="text" value="${escAttr(job.location)}"></div>
      <div><label style="margin-top:0;">Fechas</label><input class="j-dates" type="text" value="${escAttr(job.dates)}"></div>
    </div>
    <label style="margin-top:10px;">Logros / tareas (una por línea)</label>
    <textarea class="j-bullets" style="min-height:80px;">${escAttr((job.bullets||[]).join('\n'))}</textarea>
  `;
  div.querySelector('.rm-job').addEventListener('click', ()=> div.remove());
  container.appendChild(div);
}

function renderSkillsChips(){
  const container = document.getElementById('skills-container');
  container.innerHTML = '';
  skillsState.forEach((s, idx) => {
    const chip = document.createElement('span');
    chip.className = 'skill-chip';
    const nameSpan = document.createElement('span');
    nameSpan.textContent = s.name;
    chip.appendChild(nameSpan);
    const select = document.createElement('select');
    ['Avanzado','Intermedio','Básico'].forEach(lvl=>{
      const opt = document.createElement('option');
      opt.value = lvl; opt.textContent = lvl;
      if(lvl === s.level) opt.selected = true;
      select.appendChild(opt);
    });
    select.addEventListener('change', ()=> skillsState[idx].level = select.value);
    chip.appendChild(select);
    const rm = document.createElement('span');
    rm.className = 'rm'; rm.textContent = '✕';
    rm.addEventListener('click', ()=>{ skillsState.splice(idx,1); renderSkillsChips(); });
    chip.appendChild(rm);
    container.appendChild(chip);
  });
}

function fillProfileForm(p){
  document.getElementById('p-name').value = p.name || '';
  document.getElementById('p-headline').value = p.headline || '';
  document.getElementById('p-years').value = p.yearsExperience || '';
  document.getElementById('p-field').value = p.fieldOfWork || '';
  document.getElementById('p-summary').value = p.summary || '';
  document.getElementById('p-clients').value = p.notableClients || '';
  document.getElementById('p-email').value = p.email || '';
  document.getElementById('p-phone').value = p.phone || '';
  document.getElementById('p-location').value = p.location || '';
  document.getElementById('p-whatsapp').value = p.whatsappDisplay || '';
  document.getElementById('p-linkedin').value = p.linkedinUrl || '';
  document.getElementById('p-portfolio').value = p.portfolioUrl || '';
  document.getElementById('p-education').value = (p.education||[]).join('\n');
  document.getElementById('p-languages').value = p.languages || '';
  document.getElementById('jobs-container').innerHTML = '';
  const jobs = (p.experience && p.experience.length) ? p.experience : [null];
  jobs.forEach(addJobBlock);
  skillsState = (p.skills || []).map(s=>({name:s.name, level:s.level||'Intermedio'}));
  renderSkillsChips();
  document.getElementById('profile-form').style.display = '';
}

function readProfileForm(){
  const jobs = [...document.querySelectorAll('.job-block')].map(div => ({
    role: div.querySelector('.j-role').value.trim(),
    company: div.querySelector('.j-company').value.trim(),
    location: div.querySelector('.j-location').value.trim(),
    dates: div.querySelector('.j-dates').value.trim(),
    bullets: div.querySelector('.j-bullets').value.split('\n').map(s=>s.trim()).filter(Boolean)
  })).filter(j => j.role || j.company || j.bullets.length);

  const whatsappRaw = document.getElementById('p-whatsapp').value.trim();
  const whatsappDigits = whatsappRaw.replace(/[^\d]/g,'');
  let linkedinUrl = document.getElementById('p-linkedin').value.trim();
  if(linkedinUrl && !/^https?:\/\//i.test(linkedinUrl)) linkedinUrl = 'https://' + linkedinUrl;
  let portfolioUrl = document.getElementById('p-portfolio').value.trim();
  if(portfolioUrl && !/^https?:\/\//i.test(portfolioUrl)) portfolioUrl = 'https://' + portfolioUrl;

  return {
    name: document.getElementById('p-name').value.trim(),
    headline: document.getElementById('p-headline').value.trim(),
    yearsExperience: document.getElementById('p-years').value.trim(),
    fieldOfWork: document.getElementById('p-field').value.trim(),
    summary: document.getElementById('p-summary').value.trim(),
    notableClients: document.getElementById('p-clients').value.trim(),
    email: document.getElementById('p-email').value.trim(),
    phone: document.getElementById('p-phone').value.trim(),
    location: document.getElementById('p-location').value.trim(),
    whatsappDisplay: whatsappRaw,
    whatsappUrl: whatsappDigits ? `https://wa.me/${whatsappDigits}` : '',
    linkedinUrl,
    portfolioUrl,
    education: document.getElementById('p-education').value.split('\n').map(s=>s.trim()).filter(Boolean),
    languages: document.getElementById('p-languages').value.trim(),
    experience: jobs,
    skills: skillsState.slice()
  };
}

